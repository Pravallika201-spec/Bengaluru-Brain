# Copy this file to traffic_module/.env and fill in real values there.
# .env / .env.* / *.env are all gitignored (see project .gitignore) --
# NEVER commit a file with real credentials in it. This file must only
# ever contain placeholder names, never a real key/token/sid.

# --- Existing project keys (unchanged by Stage 3B) ---
OPENROUTESERVICE_API_KEY=
TOMTOM_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Citizen Alert System: dev/production toggle (Stage 1, reused as-is) ---
# "true" (default if unset) = no real SMS is ever sent; OTPs are echoed
# back in API responses for dev testing and every citizen alert delivery
# is recorded as SIMULATED_NOT_SENT.
# "false" = real sends are attempted through whichever SMS provider is
# configured below. If CITIZEN_ALERTS_DEV_MODE=false but the EXOTEL_*
# variables below are not fully set, sends FAIL safely (status=FAILED) --
# they never silently fall back to simulated or pretend to succeed.
CITIZEN_ALERTS_DEV_MODE=true

# --- Citizen Alert System: Exotel SMS provider (Stage 3B) ---
# All four required for a real send to be attempted. Leave blank/unset
# to keep CITIZEN_ALERTS_DEV_MODE=false safely degrading to FAILED
# instead of sending.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SENDER_ID=

# Optional -- defaults shown. Only uncomment/change if your Exotel
# account is provisioned on a different API subdomain, or you want a
# non-default HTTP timeout for the SMS send request.
# EXOTEL_SUBDOMAIN=api.exotel.com
# CITIZEN_ALERTS_SMS_TIMEOUT_SECONDS=10

# --- Citizen Alert System: BHASHINI Hindi translation (Stage 3C) ---
# All three required for a real translation to be attempted. Leave
# blank/unset to keep Hindi-preferring citizens safely falling back to
# English (with a visible language_fallback tag on their delivery
# record) -- this never blocks dispatch and never fabricates a
# translation.
BHASHINI_ULCA_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=

# Optional -- defaults shown. Only uncomment/change if you need a
# non-default Pipeline Config endpoint or HTTP timeout (applied to each
# of BHASHINI's two calls separately).
# BHASHINI_PIPELINE_CONFIG_URL=https://meity-auth.ulca.in/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_TIMEOUT_SECONDS=10
